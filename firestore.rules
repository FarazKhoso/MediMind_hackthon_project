/**
 * @file Firestore Security Rules
 * @description This ruleset implements a strict security model that prioritizes data privacy and user authorization.
 *
 * Core Philosophy:
 *  - All data access is denied by default. Explicit `allow` rules are required to grant access.
 *  - User data is strictly segregated. Users can only access their own data, unless explicitly allowed.
 *  - There are no global admin roles. All role-based access must be implemented via denormalized fields on documents.
 *  - List operations are generally disallowed on user-specific data to prevent information disclosure.
 *
 * Data Structure:
 *  - `/users/{userId}`: User profile information, accessible only by the user themselves.
 *  - `/providers/{providerId}`: Provider-specific details, writable only by the provider themselves.
 *  - `/bookings/{bookingId}`: Booking information, no specific ownership model.
 *  - `/users/{userId}/consultations/{consultationId}`: AI consultation history for each user, accessible only by the user.
 *
 * Key Security Decisions:
 *  - User listing is disallowed.
 *  - Provider profile creation is restricted.
 *  - Bookings do not have clear ownership and writes are disabled.
 *  - Users can only access their own consultation data.
 *
 * Denormalization for Authorization:
 *  - No denormalization is used in this ruleset as owner-only access is assumed.
 *
 * Structural Segregation:
 *  - Private user data is stored under the `/users/{userId}` path, while other data is stored in top-level collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile information.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their profile with ID 'user_abc'.
     * @deny (create) - User with UID 'user_abc' cannot create a profile with ID 'user_xyz'.
     * @allow (get, update, delete) - User with UID 'user_abc' can read and modify their profile with ID 'user_abc'.
     * @deny (get, update, delete) - User with UID 'user_abc' cannot read or modify profile with ID 'user_xyz'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId} {
      // Helper function to check if the user is signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the request is made by the owner of the document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && resource != null;
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
    }

    /**
     * @description Controls access to provider profile information.
     * @path /providers/{providerId}
     * @allow (create) - Provider with UID 'provider_abc' can create their profile with ID 'provider_abc'.
     * @deny (create) - Provider with UID 'provider_abc' cannot create a profile with ID 'provider_xyz'.
     * @allow (get, update, delete) - Provider with UID 'provider_abc' can read and modify their profile with ID 'provider_abc'.
     * @deny (get, update, delete) - Provider with UID 'provider_abc' cannot read or modify profile with ID 'provider_xyz'.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /providers/{providerId} {
       // Helper function to check if the user is signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the request is made by the owner of the document.
      function isOwner(providerId) {
        return request.auth.uid == providerId;
      }

      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(providerId);
      allow update: if isSignedIn() && isOwner(providerId) && resource != null;
      allow delete: if isSignedIn() && isOwner(providerId) && resource != null;
    }

    /**
     * @description Controls access to booking information.
     * @path /bookings/{bookingId}
     * @allow (get) - Allows any authenticated user to read booking details.
     * @deny (create, update, delete) - Disallows creation, updating, and deleting of booking documents.
     * @principle No clear ownership model. Writes are disabled.
     */
    match /bookings/{bookingId} {
        // Helper function to check if the user is signed in.
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    /**
     * @description Controls access to AI consultation history for each user.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) - User with UID 'user_abc' can create a consultation under their ID.
     * @deny (create) - User with UID 'user_abc' cannot create a consultation under another user's ID ('user_xyz').
     * @allow (get, update, delete) - User with UID 'user_abc' can read and modify their consultations.
     * @deny (get, update, delete) - User with UID 'user_abc' cannot read or modify another user's consultations.
     * @principle Enforces document ownership for writes, restricts access to a user's own data tree.
     */
    match /users/{userId}/consultations/{consultationId} {
       // Helper function to check if the user is signed in.
      function isSignedIn() {
        return request.auth != null;
      }

      // Helper function to check if the request is made by the owner of the document.
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false; // Listing consultations is not permitted
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId) && resource != null;
      allow delete: if isSignedIn() && isOwner(userId) && resource != null;
    }
  }
}