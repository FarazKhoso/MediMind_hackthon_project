/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and consultations.
 * Providers have additional restrictions on their profiles. Bookings are accessible to involved parties.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile data. Each user can only access their own profile.
 * - /providers/{providerId}: Stores provider-specific data. Providers can only manage their own data.
 * - /bookings/{bookingId}: Stores booking information.
 * - /users/{userId}/consultations/{consultationId}: Stores consultation history for each user.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Providers can manage their profile data.
 * - Listing all users or providers is disallowed.
 *
 * Denormalization for Authorization:
 * - No denormalization needed in this initial prototyping phase.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user123' can create their profile at /users/user123 if the document's id also equals 'user123'.
     * @allow (get, update, delete) - User with UID 'user123' can get, update, and delete their profile at /users/user123.
     * @deny (create) - User with UID 'user456' cannot create a profile at /users/user123.
     * @deny (update, delete) - User with UID 'user456' cannot update or delete the profile at /users/user123.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to provider profiles.
     * @path /providers/{providerId}
     * @allow (create, update, delete) - Provider with UID 'provider123' can create, update, and delete their profile at /providers/provider123.
     * @deny (create) - User with UID 'user456' cannot create a provider profile at /providers/provider123.
     * @deny (update, delete) - User with UID 'user456' cannot update or delete the profile at /providers/provider123.
     * @principle Enforces document ownership for provider profiles.
     */
    match /providers/{providerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(providerId) {
        return request.auth.uid == providerId;
      }

      function isExistingOwner(providerId) {
        return isOwner(providerId) && resource != null;
      }

      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isSignedIn() && request.auth.uid == providerId;
      allow update: if isExistingOwner(providerId);
      allow delete: if isExistingOwner(providerId);
    }

    /**
     * @description Controls access to bookings.
     * @path /bookings/{bookingId}
     * @allow (get, list) - Anyone can read booking details.
     * @allow (create) - Any authenticated user can create a booking.
     * @deny (update, delete) - Only the involved customer or provider can update/delete a booking.
     * @principle Allows public read access but restricts modification to authorized users.
     */
    match /bookings/{bookingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if true;
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if false; // TODO: Implement owner validation once the schema is updated with an ownership field.
      allow delete: if false; // TODO: Implement owner validation once the schema is updated with an ownership field.
    }

    /**
     * @description Controls access to user consultations.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) - User with UID 'user123' can create a consultation at /users/user123/consultations/consult1 if the document's userId also equals 'user123'.
     * @allow (get, update, delete, list) - User with UID 'user123' can get, update, delete and list their consultations at /users/user123/consultations/consult1.
     * @deny (create) - User with UID 'user456' cannot create a consultation at /users/user123/consultations/consult1.
     * @deny (update, delete) - User with UID 'user456' cannot update or delete the consultation at /users/user123/consultations/consult1.
     * @principle Enforces document ownership for consultations.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && request.resource.data.userId == userId && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
     match /bookings/{bookingId}/messages/{messageId} {
      function isSignedIn() {
        return request.auth != null;
      }
        allow list: if false;
        allow get: if false;
        allow create: if isSignedIn();
        allow update: if false;
        allow delete: if false;
      }
  }
}