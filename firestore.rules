/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and their associated consultations.
 * Providers have additional profile information under a separate collection, accessible only to themselves.
 * Bookings are accessible to involved customers and providers.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles.
 * - /providers/{providerId}: Stores private provider profiles.
 * - /bookings/{bookingId}: Stores booking information.
 * - /users/{userId}/consultations/{consultationId}: Stores AI consultation logs.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Providers can only read and write their own provider profile.
 * - Consultations are private to the user who created them.
 * - Listing all users or providers is disallowed.
 * - No global admin roles are defined, so administrative privileges are not implemented.
 *
 * Denormalization for Authorization:
 *  - The `Booking` entity requires both `customerId` and `providerId` to authorize access to either the customer or provider involved.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles. Users can only read/write their own profile.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates a profile with id matching their auth UID.
     * @allow (get, update, delete) User with ID 'user123' reads/updates/deletes their own profile.
     * @deny (create) User 'user456' attempts to create a profile for 'user123'.
     * @deny (get, update, delete) User 'user456' attempts to read/update/delete profile 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.email is string && request.resource.data.name is string && request.resource.data.role is string;
      allow update: if isExistingOwner(userId) && request.resource.data.email is string && request.resource.data.name is string && request.resource.data.role is string;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages provider profiles. Only the provider can read/write their own profile.
     * @path /providers/{providerId}
     * @allow (create) Provider with ID 'provider123' creates a profile with id matching their auth UID.
     * @allow (get, update, delete) Provider 'provider123' reads/updates/deletes their own profile.
     * @deny (create) Provider 'provider456' attempts to create a profile for 'provider123'.
     * @deny (get, update, delete) Provider 'provider456' attempts to read/update/delete profile 'provider123'.
     * @principle Enforces document ownership for all operations.
     */
    match /providers/{providerId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(providerId) {
        return request.auth.uid == providerId;
      }

      function isExistingOwner(providerId) {
        return isOwner(providerId) && resource != null;
      }

      allow get: if isOwner(providerId);
      allow list: if false; // Listing providers is not permitted.
      allow create: if isSignedIn() && isOwner(providerId) && request.resource.data.serviceType is string && request.resource.data.licenseUrl is string && request.resource.data.isVerified is bool && request.resource.data.availabilityStatus is string;
      allow update: if isExistingOwner(providerId) && request.resource.data.serviceType is string && request.resource.data.licenseUrl is string && request.resource.data.isVerified is bool && request.resource.data.availabilityStatus is string;
      allow delete: if isExistingOwner(providerId);
    }

    /**
     * @description Manages bookings. Customers and providers involved in the booking can access it.
     * @path /bookings/{bookingId}
     * @allow (get) Customer 'customer123' or provider 'provider456' reads booking 'booking789' where they are involved.
     * @allow (list) Listing bookings is not permitted.
     * @allow (create) Customer 'customer123' creates a booking.
     * @allow (update) Customer or Provider updates a booking they are involved in.
     * @allow (delete) Customer or Provider deletes a booking they are involved in.
     * @deny (get) User 'user789' attempts to read booking 'booking789' where they are not involved.
     * @principle Grants access to bookings only to the customer and provider involved.
     */
    match /bookings/{bookingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isCustomer(customerId) {
        return request.auth.uid == customerId;
      }

      function isProvider(providerId) {
        return request.auth.uid == providerId;
      }

      function isParticipant() {
        return isSignedIn() && (isCustomer(resource.data.customerId) || isProvider(resource.data.providerId));
      }

      function isExistingParticipant() {
          return isParticipant() && resource != null;
      }

      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);
      allow list: if false; // Listing bookings is not permitted.
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid && request.resource.data.serviceType is string && request.resource.data.location is map && request.resource.data.timing is string && request.resource.data.initialBid is number && request.resource.data.status is string;
      allow update: if isExistingParticipant() && request.resource.data.customerId is string && request.resource.data.serviceType is string && request.resource.data.location is map && request.resource.data.timing is string && request.resource.data.initialBid is number && request.resource.data.status is string;
      allow delete: if isExistingParticipant();
    }

    /**
     * @description Manages AI consultations for each user.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create, get, list) User 'user123' creates/reads/lists their own consultations.
     * @allow (update, delete) User 'user123' updates/deletes their own consultation.
     * @deny (create, get, list) User 'user456' attempts to create/read/list consultations for 'user123'.
     * @deny (update, delete) User 'user456' attempts to update/delete consultation 'consult123' for user 'user123'.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isOwner(userId) {
        return request.auth.uid == userId;
      }

        function isExistingOwner(userId) {
            return isOwner(userId) && resource != null;
        }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId && request.resource.data.id is string && request.resource.data.query is string && request.resource.data.response is string && request.resource.data.confidenceScore is number && request.resource.data.timestamp is string;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId && request.resource.data.id is string && request.resource.data.query is string && request.resource.data.response is string && request.resource.data.confidenceScore is number && request.resource.data.timestamp is string;
      allow delete: if isExistingOwner(userId);
    }
  }
}