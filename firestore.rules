/**
 * @description This ruleset enforces a strict user-ownership model for user profiles and consultation logs.
 *   It allows public read access to bookings but restricts writes to authorized users. Provider profiles
 *   are writeable only by the provider themselves.
 * @dataStructure
 *   /users/{userId}: User profile data, accessible only to the user.
 *   /providers/{providerId}: Provider profile data, writeable only by the provider themselves.
 *   /bookings/{bookingId}: Booking data, publicly readable but with restricted writes.
 *   /users/{userId}/consultations/{consultationId}: AI consultation logs, accessible only to the user.
 * @keySecurityDecisions
 *   - Users can only create their own profile.
 *   - Providers can only update their own profile.
 *   - No user listing is allowed for users or providers.
 *   - Bookings are publicly readable but writes are restricted.
 * @denormalizationForAuthorization
 *   - Consultation documents must contain the userId to enforce ownership.
 * @structuralSegregation
 *   - Drafts vs. published content is not applicable in this data model.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - A user can create their own profile if the userId matches their auth UID.
     * @allow (get, update, delete) - A user can read, update, and delete their own profile if the userId matches their auth UID.
     * @deny (create) - A user cannot create a profile with a userId that does not match their auth UID.
     * @deny (update, delete) - A user cannot update or delete a profile with a userId that does not match their auth UID, or if the document does not exist.
     * @deny (list) - User profiles cannot be listed.
     * @principle Enforces document ownership for writes and restricts access to a user's own data.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get: if isOwner(userId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Controls access to provider profile documents.
     * @path /providers/{providerId}
     * @allow (create) - A provider can create their own profile if the providerId matches their auth UID.
     * @allow (get, update, delete) - A provider can read, update, and delete their own profile if the providerId matches their auth UID.
     * @deny (create) - A provider cannot create a profile with a providerId that does not match their auth UID.
     * @deny (update, delete) - A provider cannot update or delete a profile with a providerId that does not match their auth UID, or if the document does not exist.
     * @deny (list) - Provider profiles cannot be listed.
     * @principle Enforces document ownership for writes and restricts access to a provider's own data.
     */
    match /providers/{providerId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(providerId) {
        return request.auth.uid == providerId;
      }
        function isExistingOwner(providerId) {
        return isOwner(providerId) && exists(resource);
      }

      allow get: if isOwner(providerId);
      allow list: if false;

      allow create: if isSignedIn() && isOwner(providerId);
      allow update: if isExistingOwner(providerId);
      allow delete: if isExistingOwner(providerId);
    }

    /**
     * @description Controls access to booking documents.
     * @path /bookings/{bookingId}
     * @allow (get, list) - All users can read bookings.
     * @deny (create, update, delete) - Only authorized users can create, update, or delete bookings.
     * @principle Public read access with restricted writes.
     */
    match /bookings/{bookingId} {
      allow get, list: if true;
      allow create, update, delete: if false; // TODO: Implement booking write rules.
    }

    /**
     * @description Controls access to consultation log documents within a user's subcollection.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) - A user can create a consultation log under their own user ID, provided the userId in the document matches the path.
     * @allow (get, list, update, delete) - A user can read, list, update, and delete their own consultation logs if the userId matches their auth UID.
     * @deny (create) - A user cannot create a consultation log under a different user ID.
     * @deny (update, delete) - A user cannot update or delete a consultation log if the userId does not match their auth UID, or if the document does not exist.
     * @principle Enforces document ownership and validates relational integrity between the path and the document data.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
        return isOwner(userId) && exists(resource);
      }

      allow get, list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}