rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' creates their profile.
     * @allow (get) User with ID 'user123' retrieves their profile.
     * @allow (update) User with ID 'user123' updates their profile.
     * @allow (delete) User with ID 'user123' deletes their profile.
     * @deny (create) User with ID 'user456' attempts to create a profile for 'user123'.
     * @deny (get) User with ID 'user456' attempts to retrieve 'user123' profile.
     * @principle Enforces user-ownership: users can only manage their own profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Controls access to provider profiles.
     * @path /providers/{providerId}
     * @allow (create) Provider with ID 'provider123' creates their profile.
     * @allow (get) Provider with ID 'provider123' retrieves their profile.
     * @allow (update) Provider with ID 'provider123' updates their profile.
     * @allow (delete) Provider with ID 'provider123' deletes their profile.
     * @deny (create) User with ID 'user456' attempts to create a provider profile for 'provider123'.
     * @deny (get) User with ID 'user456' attempts to retrieve 'provider123' profile.
     * @principle Enforces user-ownership: providers can only manage their own profiles.
     */
    match /providers/{providerId} {
      function isOwner(providerId) {
        return request.auth.uid == providerId;
      }

      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isOwner(providerId);
      allow update: if isOwner(providerId);
      allow delete: if isOwner(providerId);
    }

    /**
     * @description Controls access to booking requests.
     * @path /bookings/{bookingId}
     * @allow (get) Customer 'customer123' retrieves booking 'bookingXYZ' where they are the customer.
     * @allow (get) Provider 'provider456' retrieves booking 'bookingXYZ' where they are the provider.
     * @allow (create) Customer 'customer123' creates a new booking.
     * @allow (update) Customer 'customer123' updates booking 'bookingXYZ' where they are the customer.
     * @allow (update) Provider 'provider456' updates booking 'bookingXYZ' where they are the provider.
     * @deny (get) User 'user789' tries to read a booking they are not part of.
     * @principle Shared access: Allows read/write access to customers and providers for bookings they are involved in.
     */
    match /bookings/{bookingId} {
        function isCustomerOrProvider(customerId, providerId) {
          return request.auth.uid == customerId || request.auth.uid == providerId;
        }
        function isValidBookingCreate() {
          return request.resource.data.customerId == request.auth.uid;
        }

        allow get: if isCustomerOrProvider(resource.data.customerId, resource.data.providerId);
        allow list: if false;
        allow create: if isValidBookingCreate();
        allow update: if isCustomerOrProvider(resource.data.customerId, resource.data.providerId);
        allow delete: if false; // Bookings should not be deleted through the client app
    }

    /**
     * @description Controls access to AI consultations for each user.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) User with ID 'user123' creates a consultation.
     * @allow (get) User with ID 'user123' retrieves their own consultation.
     * @allow (update) User with ID 'user123' updates their own consultation.
     * @allow (delete) User with ID 'user123' deletes their own consultation.
     * @deny (create) User with ID 'user456' attempts to create a consultation for 'user123'.
     * @deny (get) User with ID 'user456' attempts to retrieve 'user123' consultations.
     * @principle Enforces user-ownership: users can only manage their own consultations.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }

  function isSignedIn() {
    return request.auth != null;
  }
}