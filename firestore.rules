/**
 * @fileoverview Firestore Security Rules for the MedApp application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and consultations,
 * while allowing controlled access to provider profiles and bookings based on participation.
 * Only authenticated users can access data, and authorization checks are performed
 * to ensure users can only access their own profiles and consultations, or bookings
 * in which they are a participant (either as customer or provider).
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles.
 * - /providers/{providerId}: Stores private provider profiles.
 * - /bookings/{bookingId}: Stores booking information.
 * - /users/{userId}/consultations/{consultationId}: Stores AI consultation data.
 *
 * Key Security Decisions:
 * - User listing is disabled for security reasons.
 * - Provider profiles are writeable only by the provider themselves and admin.
 * - Bookings are accessible to the customer and provider involved.
 * - Consultations are private to each user.
 *
 * Denormalization for Authorization:
 * - Bookings: Both `customerId` and `providerId` are used for authorization,
 *   allowing rules to quickly check if the requesting user is a participant.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces authentication for all requests.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the requesting user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the requesting user is the existing owner of the resource.
     * This ensures that the document exists before allowing updates or deletes.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description User profiles are private and only accessible to the user and admins.
     * @path /users/{userId}
     * @allow (read, write): User 'test_user' with ID 'user_abc' can read/write their own profile.
     * @deny (read, write): User 'another_user' with ID 'user_xyz' cannot read/write user 'test_user' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Provider profiles are private and only accessible to the provider and admins.
     * @path /providers/{providerId}
     * @allow (read, write): Provider 'test_provider' with ID 'provider_abc' can read/write their own profile.
     * @deny (read, write): User 'another_user' with ID 'user_xyz' cannot read/write provider 'test_provider' profile.
     * @principle Enforces document ownership for all operations.
     */
    match /providers/{providerId} {
      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isOwner(providerId);
      allow update: if isExistingOwner(providerId);
      allow delete: if isExistingOwner(providerId);
    }

    /**
     * @description Bookings are accessible to the customer and provider involved.
     * @path /bookings/{bookingId}
     * @allow (read, write): User 'customer_abc' can read/write a booking where customerId == 'customer_abc' || providerId == 'customer_abc'.
     * @deny (read, write): User 'another_user' with ID 'user_xyz' cannot read/write booking they are not part of.
     * @principle Allows shared access between customer and provider for booking data.
     */
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);
      allow list: if false;
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid) && resource != null;
      allow delete: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid) && resource != null;
    }

    /**
     * @description Consultations are private to each user.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (read, write): User 'test_user' with ID 'user_abc' can read/write their own consultations.
     * @deny (read, write): User 'another_user' with ID 'user_xyz' cannot read/write user 'test_user' consultations.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/consultations/{consultationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}