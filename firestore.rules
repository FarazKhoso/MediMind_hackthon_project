/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and consultations,
 *              and a shared-access model for bookings. Provider profiles have restricted write access.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information, accessible only to the user.
 * - /providers/{providerId}: Stores private provider information, accessible only to the provider.
 * - /bookings/{bookingId}: Stores booking information, accessible to the involved customer and provider.
 * - /users/{userId}/consultations/{consultationId}: Stores AI consultation history, accessible only to the user.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Provider profiles can only be created and modified by the provider themselves.
 * - Bookings are accessible to both the customer and provider involved.
 * - Consultations are private to the user who created them.
 * - Listing of all bookings is allowed for authenticated users.
 *
 * Denormalization for Authorization:
 * - Bookings require both `customerId` and `providerId` fields to determine access.
 *
 * Structural Segregation:
 * - User profiles and provider profiles are stored in separate collections.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to user profiles. Users can only read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create their own profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (get) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can read their own profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (update) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can update their own profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (delete) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can delete their own profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (create) - User 'attackerId' cannot create a profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (get) - User 'attackerId' cannot read profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (update) - User 'attackerId' cannot update profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (delete) - User 'attackerId' cannot delete profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.email == request.auth.token.email;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.email == request.auth.token.email;
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.email == request.auth.token.email;
    }

    /**
     * @description Manages access to provider profiles. Only the provider can create, read, update and delete their profile.
     * @path /providers/{providerId}
     * @allow (create) - Provider 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create their own profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (get) - Provider 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can read their own profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (update) - Provider 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can update their own profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (delete) - Provider 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can delete their own profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (create) - User 'attackerId' cannot create a profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (get) - User 'attackerId' cannot read profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (update) - User 'attackerId' cannot update profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (delete) - User 'attackerId' cannot delete profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @principle Enforces document ownership for writes.
     */
    match /providers/{providerId} {
      allow get: if isSignedIn() && isOwner(providerId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(providerId);
      allow update: if isSignedIn() && isExistingOwner(providerId);
      allow delete: if isSignedIn() && isExistingOwner(providerId);
    }

    /**
     * @description Manages access to booking requests. Accessed by customers and providers involved.
     * @path /bookings/{bookingId}
     * @allow (create) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create a booking if the customerId matches their UID.
     * @allow (get) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can get a booking if they are the customer or provider.
     * @allow (update) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can update a booking if they are the customer or provider and it exists.
     * @allow (delete) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can delete a booking if they are the customer or provider and it exists.
     * @deny (create) - User 'attackerId' cannot create a booking for another customer.
     * @deny (get) - User 'attackerId' cannot get a booking they are not involved in.
     * @deny (update) - User 'attackerId' cannot update a booking they are not involved in.
     * @deny (delete) - User 'attackerId' cannot delete a booking they are not involved in.
     * @principle Enforces shared access based on customerId and providerId.
     */
    match /bookings/{bookingId} {
      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid;
      allow update: if isSignedIn() && isExistingCustomerOrProvider(resource.data.customerId, resource.data.providerId);
      allow delete: if isSignedIn() && isExistingCustomerOrProvider(resource.data.customerId, resource.data.providerId);
    }

    /**
     * @description Manages access to AI consultations. Each user can only access their own consultations.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create a consultation under their user ID.
     * @allow (get) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can read a consultation under their user ID.
     * @allow (update) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can update a consultation under their user ID if it exists.
     * @allow (delete) - User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can delete a consultation under their user ID if it exists.
     * @deny (create) - User 'attackerId' cannot create a consultation under another user's ID.
     * @deny (get) - User 'attackerId' cannot read a consultation under another user's ID.
     * @deny (update) - User 'attackerId' cannot update a consultation under another user's ID.
     * @deny (delete) - User 'attackerId' cannot delete a consultation under another user's ID.
     * @principle Enforces user-specific data access.
     */
    match /users/{userId}/consultations/{consultationId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isSignedIn() && isOwner(userId) && resource.data.userId == userId && resource != null;
      allow delete: if isSignedIn() && isOwner(userId) && resource.data.userId == userId && resource != null;
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }

  function isCustomerOrProvider(customerId, providerId) {
      return request.auth.uid == customerId || request.auth.uid == providerId;
  }

    function isExistingCustomerOrProvider(customerId, providerId) {
    return resource != null && isCustomerOrProvider(customerId, providerId);
  }
}