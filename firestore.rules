/**
 * @fileoverview Firestore Security Rules for the med-app application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and consultations.
 * Provider profiles are also owned by the user, with additional restrictions for admin verification.
 * Bookings follow a shared-access model, where both the customer and provider have access.
 *
 * Data Structure:
 * - /users/{userId}: User profile information.
 * - /providers/{providerId}: Provider profile information.
 * - /bookings/{bookingId}: Booking requests and status.
 * - /users/{userId}/consultations/{consultationId}: AI consultation history for each user.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data.
 * - Providers can only manage their own provider profile.
 * - Bookings are accessible to both the customer and provider involved.
 * - Consultations are only accessible to the user who created them.
 * - There is no user listing.
 *
 * Denormalization for Authorization:
 *  - No denormalization is explicitly required based on the current data model, as path-based ownership and shared access patterns are used.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profile access. Users can only read and write their own profile.
     * @path /users/{userId}
     * @allow (create, update, delete) User with ID 'user123' can create/update/delete their own profile.
     * @deny (create, update, delete) User with ID 'user456' cannot create/update/delete the profile of 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Listing users is not permitted

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages provider profile access. Only the provider can manage their profile.
     * @path /providers/{providerId}
     * @allow (create, update, delete) Provider with ID 'provider123' can create/update/delete their own profile.
     * @deny (create, update, delete) User with ID 'user456' cannot create/update/delete the profile of 'provider123'.
     * @principle Enforces document ownership for writes.
     */
    match /providers/{providerId} {
      allow get: if isSignedIn();
      allow list: if false; // Listing providers is not permitted

      allow create: if isOwner(providerId);
      allow update: if isExistingOwner(providerId);
      allow delete: if isExistingOwner(providerId);
    }

    /**
     * @description Manages booking access.  Accessed by customers and providers involved.
     * @path /bookings/{bookingId}
     * @allow (get, update) User with ID 'user123' who is either the customer or provider for booking 'booking456' can access and modify.
     * @deny (get, update) User with ID 'user789' who is not involved in booking 'booking456' cannot access or modify it.
     * @principle Enforces shared access based on customerId and providerId.
     */
    match /bookings/{bookingId} {
      allow get: if isSignedIn();
      allow list: if false; // Listing bookings is not permitted

      allow create: if request.auth.uid == request.resource.data.customerId;
      allow update: if (resource != null) && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.providerId);
      allow delete: if false;
    }

    /**
     * @description Manages AI consultation access. Only the user can access their consultations.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create, get, list, update, delete) User with ID 'user123' can create/access/manage their own consultations.
     * @deny (create, get, list, update, delete) User with ID 'user456' cannot create/access/manage the consultations of 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/consultations/{consultationId} {
      allow get: if isSignedIn() && isOwner(userId);
      allow list: if isSignedIn() && isOwner(userId); // Owner can list their own consultations
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && resource.data.userId == userId;
      allow delete: if isExistingOwner(userId) && resource.data.userId == userId;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }
  }
}