/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes strict authorization based on user identity and
 * relationships, while minimizing schema enforcement to enable rapid prototyping.
 * It enforces ownership and shared access patterns where appropriate.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the user themselves.
 * - /providers/{providerId}: Provider profiles, accessible only by the provider themselves.
 * - /bookings/{bookingId}: Bookings, with access controlled to involved users.
 * - /users/{userId}/consultations/{consultationId}: AI consultations for each user, accessible only by the user themselves.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Data validation is minimized to essential ownership and relationship checks.
 * - Write rules never use `if true;` to prevent accidental open access.
 *
 * Denormalization for Authorization:
 * This ruleset does not require denormalization. The authorization rules are
 * structured around path-based ownership and, if needed, document-based
 * member lists, eliminating the need for `get()` calls to other documents.
 *
 * Structural Segregation:
 * Private user data (e.g., consultations) is stored in user-specific
 * subcollections, while public data (e.g., potentially bookings) resides in
 * top-level collections. This improves security and performance for list
 * operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Checks if the request is made by the owner of the resource.
     * @param {string} userId - The user ID to check against.
     * @return {boolean} - True if the user is the owner, false otherwise.
     */
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    /**
     * @description Checks if the request is made by a valid, signed-in user.
     * @return {boolean} - True if the user is signed in, false otherwise.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the user is the owner of the existing resource (for update/delete).
     * @param {string} userId - The user ID to check against.
     * @return {boolean} - True if the user is the owner and the document exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    /**
     * @description Defines access rules for user profiles.
     * @path /users/{userId}
     * @allow (create) User with ID 'user123' can create their profile.
     *   request.auth.uid == 'user123' and request.resource.data.id == 'user123'
     * @allow (get) User with ID 'user123' can read their profile.
     *   request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' can update their profile.
     *   request.auth.uid == 'user123' and resource != null
     * @allow (delete) User with ID 'user123' can delete their profile.
     *   request.auth.uid == 'user123' and resource != null
     * @deny (create) User with ID 'user456' cannot create a profile for 'user123'.
     *   request.auth.uid == 'user456' and request.resource.data.id == 'user123'
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Listing users is not permitted.
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Defines access rules for provider profiles.
     * @path /providers/{providerId}
     * @allow (create) Provider with ID 'provider123' can create their profile.
     *   request.auth.uid == 'provider123'
     * @allow (get) Provider with ID 'provider123' can read their profile.
     *   request.auth.uid == 'provider123'
     * @allow (update) Provider with ID 'provider123' can update their profile.
     *   request.auth.uid == 'provider123' and resource != null
     * @allow (delete) Provider with ID 'provider123' can delete their profile.
     *   request.auth.uid == 'provider123' and resource != null
     * @deny (create) User with ID 'user456' cannot create a provider profile for 'provider123'.
     *   request.auth.uid == 'user456'
     * @principle Enforces document ownership for writes and reads.
     */
    match /providers/{providerId} {
      allow get: if isOwner(providerId);
      allow list: if false; // Listing providers is not permitted.
      allow create: if isOwner(providerId);
      allow update: if isExistingOwner(providerId);
      allow delete: if isExistingOwner(providerId);
    }

    /**
     * @description Defines access rules for bookings.
     * @path /bookings/{bookingId}
     * @allow (get) Any signed-in user can read a booking.
     *   request.auth.uid != null
     * @allow (list) Any signed-in user can list bookings.
     *   request.auth.uid != null
     * @allow (create) Any signed-in user can create a booking.
     *   request.auth.uid != null
     * @allow (update) Any signed-in user can update a booking.
     *   request.auth.uid != null and resource != null
     * @allow (delete) Any signed-in user can delete a booking.
     *   request.auth.uid != null and resource != null
     * @deny (create) Anonymous user cannot create a booking.
     *   request.auth == null
     * @principle Allows public read access, but requires authentication for write access.
     */
    match /bookings/{bookingId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }

     /**
      * @description Defines access rules for messages subcollection within bookings.
      * @path /bookings/{bookingId}/messages/{messageId}
      * @allow (get) Any signed-in user can read a message within a booking.
      *   request.auth.uid != null
      * @allow (list) Any signed-in user can list messages within a booking.
      *   request.auth.uid != null
      * @allow (create) Any signed-in user can create a message within a booking.
      *   request.auth.uid != null
      * @allow (update) Any signed-in user can update a message within a booking.
      *   request.auth.uid != null and resource != null
      * @allow (delete) Any signed-in user can delete a message within a booking.
      *   request.auth.uid != null and resource != null
      * @deny (create) Anonymous user cannot create a message in a booking.
      *   request.auth == null
      * @principle Allows public read access, but requires authentication for write access.
      */
    match /bookings/{bookingId}/messages/{messageId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn() && resource != null;
      allow delete: if isSignedIn() && resource != null;
    }


    /**
     * @description Defines access rules for AI consultations.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) User with ID 'user123' can create a consultation.
     *   request.auth.uid == 'user123' and request.resource.data.userId == 'user123'
     * @allow (get) User with ID 'user123' can read their consultation.
     *   request.auth.uid == 'user123'
     * @allow (update) User with ID 'user123' can update their consultation.
     *   request.auth.uid == 'user123' and resource != null
     * @allow (delete) User with ID 'user123' can delete their consultation.
     *   request.auth.uid == 'user123' and resource != null
     * @deny (create) User with ID 'user456' cannot create a consultation for 'user123'.
     *   request.auth.uid == 'user456' and request.resource.data.userId == 'user123'
     * @principle Enforces document ownership for writes and reads within a user's data tree.
     */
    match /users/{userId}/consultations/{consultationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }
}