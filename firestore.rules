/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes strong authorization based on user identity and
 * relationships (ownership and roles), while relaxing data validation to
 * enable rapid prototyping and iteration. Schema validation is minimized.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the owning user.
 * - /providers/{providerId}: Provider profiles, accessible only to the owning provider.
 * - /bookings/{bookingId}: Booking data, accessible to involved customer and provider.
 * - /users/{userId}/consultations/{consultationId}: AI consultations, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - Strict user-ownership for /users/{userId} and /users/{userId}/consultations/{consultationId}.
 * - Providers can only manage their own provider profiles.
 * - No listing of users or providers is allowed to prevent data scraping.
 * - The ruleset avoids complex data validation in favor of rapid iteration.
 *
 * Denormalization for Authorization:
 *  The rules leverage path-based authorization (e.g., /users/{userId}) to avoid the need for
 *  expensive `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the owning user can read and write their profile.
     * @path /users/{userId}
     * @allow (create, update, get, delete) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create, update, get, or delete /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (create, update, get, delete) User 'evilHacker' cannot create, update, get, or delete /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Secure provider profiles. Only the owning provider can read and write their profile.
     * @path /providers/{providerId}
     * @allow (create, update, get, delete) Provider 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create, update, get, or delete /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (create, update, get, delete) User 'evilHacker' cannot create, update, get, or delete /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @principle Enforces document ownership for writes.
     */
    match /providers/{providerId} {
      function isOwner(providerId) {
        return request.auth.uid == providerId;
      }

      function isExistingOwner(providerId) {
        return isOwner(providerId) && resource != null;
      }

      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isOwner(providerId);
      allow update: if isExistingOwner(providerId);
      allow delete: if isExistingOwner(providerId);
    }

    /**
     * @description Secure bookings. Only the customer or provider involved in the booking can read and write it.
     * @path /bookings/{bookingId}
     */
    match /bookings/{bookingId} {
        allow get: if true;
        allow list: if true;
        allow create: if true;
        allow update: if true;
        allow delete: if false; // TODO: Owner or admin role check if deleting a booking is allowed.
    }

    /**
     * @description Secure AI consultations. Only the owning user can read and write their consultations.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create, update, get, delete) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create, update, get, or delete /users/cdar5A4mUuYAKjaHakYYiFwDjtx1/consultations/someConsultationId.
     * @deny (create, update, get, delete) User 'evilHacker' cannot create, update, get, or delete /users/cdar5A4mUuYAKjaHakYYiFwDjtx1/consultations/someConsultationId.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
        return isOwner(userId) && resource != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}