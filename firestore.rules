/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and AI consultations.
 * Bookings are accessible to both the customer and provider involved.
 * Provider profiles are private and only writable by the provider.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles, accessible only to the user themselves.
 * - /providers/{providerId}: Stores provider-specific details, writable only by the provider.
 * - /bookings/{bookingId}: Stores booking information, accessible to the customer and provider.
 * - /users/{userId}/consultations/{consultationId}: Stores AI consultation data, accessible only to the user.
 *
 * Key Security Decisions:
 * - User listing is disallowed.
 * - Owner-only access is enforced by matching the Firebase Auth UID against document IDs in the path.
 * - No schema validation is performed other than ensuring ownership for critical fields.
 *
 * Denormalization for Authorization:
 * - Booking documents need to be accessible by both customer and provider. To avoid complex `get()` calls, the Booking document must contain both `customerId` and `providerId` fields.
 *
 * Structural Segregation:
 * - User profiles and provider profiles are stored in separate top-level collections to clearly differentiate their roles and access control.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Restricts access to user profiles. Only the user can read or write their own profile.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile at /users/user123.
     * @deny (create) User with UID 'user456' cannot create a profile at /users/user123.
     * @allow (get) User with UID 'user123' can get their profile at /users/user123.
     * @deny (get) User with UID 'user456' cannot get the profile at /users/user123.
     * @allow (update) User with UID 'user123' can update their profile at /users/user123.
     * @deny (update) User with UID 'user456' cannot update the profile at /users/user123.
     * @allow (delete) User with UID 'user123' can delete their profile at /users/user123.
     * @deny (delete) User with UID 'user456' cannot delete the profile at /users/user123.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Restricts access to provider profiles. Only the provider can read or write their own profile.
     * @path /providers/{providerId}
     * @allow (create) Provider with UID 'provider123' can create their profile at /providers/provider123.
     * @deny (create) User with UID 'user456' cannot create a profile at /providers/provider123.
     * @allow (get) Provider with UID 'provider123' can get their profile at /providers/provider123.
     * @deny (get) User with UID 'user456' cannot get the profile at /providers/provider123.
     * @allow (update) Provider with UID 'provider123' can update their profile at /providers/provider123.
     * @deny (update) User with UID 'user456' cannot update the profile at /providers/provider123.
     * @allow (delete) Provider with UID 'provider123' can delete their profile at /providers/provider123.
     * @deny (delete) User with UID 'user456' cannot delete the profile at /providers/provider123.
     * @principle Enforces document ownership for writes.
     */
    match /providers/{providerId} {
      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isOwner(providerId);
      allow update: if isExistingOwner(providerId);
      allow delete: if isExistingOwner(providerId);
    }

    /**
     * @description Allows customers and providers involved in a booking to access booking data.
     * @path /bookings/{bookingId}
     * @allow (create) A user can create a booking with their userId.
     * @deny (create) A user cannot create a booking for another user.
     * @allow (get) A customer or provider can get a booking if they are part of it.
     * @deny (get) A user cannot get a booking if they are not part of it.
     * @allow (list) Listing is not allowed.
     * @allow (update) A customer or provider can update a booking if they are part of it.
     * @deny (update) A user cannot update a booking if they are not part of it.
     * @allow (delete) A customer or provider can delete a booking if they are part of it.
     * @deny (delete) A user cannot delete a booking if they are not part of it.
     * @principle Enforces shared access for booking documents based on customerId and providerId.
     */
    match /bookings/{bookingId} {
      allow get: if isCustomerOrProvider(resource.data.customerId, resource.data.providerId);
      allow list: if false;
      allow create: if request.auth != null && request.resource.data.customerId == request.auth.uid;
      allow update: if isExistingCustomerOrProvider(resource.data.customerId, resource.data.providerId);
      allow delete: if isExistingCustomerOrProvider(resource.data.customerId, resource.data.providerId);

       /**
        * @description Restricts access to messages within a booking. Only the customer or provider involved in the booking can list messages.
        * @path /bookings/{bookingId}/messages/{messageId}
        * @allow (list) A customer or provider can list messages if they are part of the parent booking.
        * @deny (list) A user cannot list messages if they are not part of the parent booking.
        * @principle Enforces shared access for booking subcollections based on customerId and providerId in the parent document.
        */
      match /bookings/{bookingId}/messages/{messageId} {
          allow get: if false;
          allow list: if isCustomerOrProvider(get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId, get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId);
          allow create: if false;
          allow update: if false;
          allow delete: if false;
      }
    }

    /**
     * @description Restricts access to AI consultations. Only the user can read or write their own consultations.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) User with UID 'user123' can create a consultation at /users/user123/consultations/consultation456.
     * @deny (create) User with UID 'user456' cannot create a consultation at /users/user123/consultations/consultation456.
     * @allow (get) User with UID 'user123' can get their consultation at /users/user123/consultations/consultation456.
     * @deny (get) User with UID 'user456' cannot get the consultation at /users/user123/consultations/consultation456.
     * @allow (list) User with UID 'user123' can list their consultations at /users/user123/consultations.
     * @deny (list) User with UID 'user456' cannot list the consultations at /users/user123/consultations.
     * @allow (update) User with UID 'user123' can update their consultation at /users/user123/consultations/consultation456.
     * @deny (update) User with UID 'user456' cannot update the consultation at /users/user123/consultations/consultation456.
     * @allow (delete) User with UID 'user123' can delete their consultation at /users/user123/consultations/consultation456.
     * @deny (delete) User with UID 'user456' cannot delete the consultation at /users/user123/consultations/consultation456.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/consultations/{consultationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isExistingOwner(userId) && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return isSignedIn() && request.auth.uid == userId;
  }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }

  function isCustomerOrProvider(customerId, providerId) {
    return isSignedIn() && (request.auth.uid == customerId || request.auth.uid == providerId);
  }

  function isExistingCustomerOrProvider(customerId, providerId) {
      return isCustomerOrProvider(customerId, providerId) && resource != null;
  }
}