/**
 * @fileoverview Firestore Security Rules for the HealthConnect application.
 *
 * Core Philosophy:
 * This ruleset prioritizes user data ownership and role-based access control.
 * Users can only read and write their own data, while providers have specific
 * rules to manage their profiles and bookings. Data validation is relaxed to
 * enable rapid prototyping and iteration.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles, accessible only to the owning user.
 * - /providers/{providerId}: Stores private provider profiles, accessible only to the provider.
 * - /bookings/{bookingId}: Stores booking information, accessible to involved customers and providers.
 * - /users/{userId}/consultations/{consultationId}: Stores AI consultations, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - User listing is disallowed for privacy.
 * - Provider profiles are private and require authentication.
 * - Bookings can be updated by either the customer or the provider involved.
 * - The ruleset is designed for rapid prototyping and does not enforce strict data validation.
 *
 * Denormalization for Authorization:
 * - The `bookings` collection relies on denormalized `customerId` and `providerId` fields to
 * determine access rights, avoiding the need for costly `get()` operations.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-based access control for user profiles.
     * @path /users/{userId}
     * @allow (get, list): Authenticated user can read their own profile.
     * @allow (create, update, delete): Authenticated user can manage their own profile.
     * @deny (get, list): Unauthorized access to other user profiles.
     * @deny (create, update, delete): Modifying other user profiles.
     * @principle Enforces strict user-ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Enforces provider-based access control for provider profiles.
     * @path /providers/{providerId}
     * @allow (get, list): Provider can read their own profile.
     * @allow (create, update, delete): Provider can manage their own profile.
     * @deny (get, list): Unauthorized access to other provider profiles.
     * @deny (create, update, delete): Modifying other provider profiles.
     * @principle Enforces strict provider-ownership for all operations.
     */
    match /providers/{providerId} {
      function isOwner(providerId) {
        return request.auth != null && request.auth.uid == providerId;
      }
      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isOwner(providerId);
      allow update: if isOwner(providerId);
      allow delete: if isOwner(providerId);
    }

    /**
     * @description Controls access to booking documents based on the customerId or providerId.
     * @path /bookings/{bookingId}
     * @allow (get, list): Customer or Provider can read booking details.
     * @allow (create): Customer can create a booking request.
     * @allow (update): Customer or Provider can update booking details.
     * @deny (create, update, delete): Unauthorized users cannot create or modify booking details.
     * @principle Grants access to users involved in the booking.
     */
    match /bookings/{bookingId} {
        allow get: if request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId || request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId;
        allow list: if false;
        allow create: if request.auth != null;
        allow update: if request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId || request.auth.uid == get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId;
        allow delete: if false; // Prevent accidental deletion of bookings.
    }

    /**
     * @description Enforces user-based access control for AI consultations.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (get, list): Authenticated user can read their own consultations.
     * @allow (create, update, delete): Authenticated user can manage their own consultations.
     * @deny (get, list): Unauthorized access to other user's consultations.
     * @deny (create, update, delete): Modifying other user's consultations.
     * @principle Enforces strict user-ownership for all operations.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}