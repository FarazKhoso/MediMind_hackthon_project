/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and consultations.
 * Providers have ownership over their profiles. Bookings are accessible to both the customer and provider involved.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profiles. Only the user can read/write their own profile.
 * - /providers/{providerId}: Stores provider-specific data. Only the provider can read/write their own profile.
 * - /bookings/{bookingId}: Stores booking information, accessible by both the customer and provider.
 * - /users/{userId}/consultations/{consultationId}: Stores consultation history for each user. Only the user can access their own consultations.
 *
 * Key Security Decisions:
 * - Users can only manage their own profiles and consultations.
 * - Providers can only manage their own profiles.
 * - Bookings are accessible to both the customer and provider involved.
 * - Data shape validation is relaxed to allow rapid iteration.
 *
 * Denormalization for Authorization:
 * - Bookings require customerId and providerId to be present on the document to authorize read/write access for relevant users.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Controls access to user profile documents.
     * @path /users/{userId}
     * @allow (create) - User with UID 'user_abc' can create their own profile if request.auth.uid == 'user_abc'.
     * @allow (get, update, delete) - User with UID 'user_abc' can read/update/delete their own profile.
     * @deny (create) - User with UID 'user_xyz' cannot create a profile for 'user_abc'.
     * @deny (update, delete) - User with UID 'user_xyz' cannot update/delete the profile of 'user_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.id == userId;
      allow update: if isOwner(userId) && resource.data.id == userId;
      allow delete: if isOwner(userId) && resource.data.id == userId;
    }

    /**
     * @description Controls access to provider profile documents.
     * @path /providers/{providerId}
     * @allow (create) - Provider with UID 'provider_abc' can create their own profile if request.auth.uid == 'provider_abc'.
     * @allow (get, update, delete) - Provider with UID 'provider_abc' can read/update/delete their own profile.
     * @deny (create) - User with UID 'user_xyz' cannot create a profile for 'provider_abc'.
     * @deny (update, delete) - User with UID 'user_xyz' cannot update/delete the profile of 'provider_abc'.
     * @principle Enforces document ownership for writes.
     */
    match /providers/{providerId} {
      function isOwner(providerId) {
        return request.auth != null && request.auth.uid == providerId;
      }
      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isOwner(providerId);
      allow update: if isOwner(providerId) && resource != null;
      allow delete: if isOwner(providerId) && resource != null;
    }

    /**
     * @description Controls access to booking documents.
     * @path /bookings/{bookingId}
     * @allow (get, list) - Customer or Provider involved in the booking can read the booking details.
     * @allow (create) - Customer or Provider can create a booking.
     * @allow (update, delete) - Only the Customer or Provider involved can update/delete, but only if the document exists.
     * @deny (create) - A user cannot create a booking with mismatched customerId or providerId.
     * @principle Allows read/write access to bookings for involved users.
     */
    match /bookings/{bookingId} {
      function isParticipant() {
        return request.auth != null && (request.auth.uid == resource.data.customerId || request.auth.uid == resource.data.providerId);
      }

      function isNewParticipant() {
        return request.auth != null && (request.auth.uid == request.resource.data.customerId || request.auth.uid == request.resource.data.providerId);
      }
      allow get: if isParticipant();
      allow list: if true;
      allow create: if isNewParticipant();
      allow update: if isParticipant() && resource != null;
      allow delete: if isParticipant() && resource != null;
    }

    /**
     * @description Controls access to consultation documents under a user's profile.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (get, list) - Only the user can access their own consultations.
     * @allow (create) - The user can create a consultation under their ID.
     * @allow (update, delete) - The user can update/delete consultations under their ID, but only if the document exists.
     * @deny (create) - User 'user_xyz' cannot create a consultation under 'user_abc' ID.
     * @deny (update, delete) - User 'user_xyz' cannot update/delete a consultation under 'user_abc' ID.
     * @principle Restricts access to a user's own consultation history.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow update: if isOwner(userId) && resource.data.userId == userId && resource != null;
      allow delete: if isOwner(userId) && resource.data.userId == userId && resource != null;
    }
  }
}