/**
 * @file Firestore Security Rules
 * @description This ruleset enforces a strict user-ownership model for user profiles and consultations,
 *              and allows access to bookings for users involved in the booking. Provider profiles are
 *              restricted to the provider themselves and admins.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the user themselves.
 * - /providers/{providerId}: Provider profiles, accessible only by the provider themselves and admins.
 * - /bookings/{bookingId}: Bookings, accessible to customers and providers involved.
 * - /users/{userId}/consultations/{consultationId}: AI consultations, accessible only by the user.
 *
 * Key Security Decisions:
 * - User listing is disallowed to protect privacy.
 * - Provider listing is disallowed to protect privacy.
 * - Flexible data validation during prototyping to allow for rapid schema iteration, but critical authorization
 *   fields are validated.
 *
 * Denormalization for Authorization:
 * - Bookings must include customerId and providerId to allow rules to verify access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (create) User with UID 'user123' can create their profile if request.auth.uid == 'user123'.
     * @allow (get, update, delete) User with UID 'user123' can read, update, and delete their profile.
     * @deny (create) User with UID 'user123' cannot create a profile for 'user456'.
     * @deny (update, delete) User with UID 'user456' cannot update or delete the profile of 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Allows providers to manage their own profile.
     * @path /providers/{providerId}
     * @allow (create) Provider with UID 'provider123' can create their profile if request.auth.uid == 'provider123'.
     * @allow (get, update, delete) Provider with UID 'provider123' can read, update, and delete their profile.
     * @deny (create) Provider with UID 'provider123' cannot create a profile for 'provider456'.
     * @deny (update, delete) User with UID 'provider456' cannot update or delete the profile of 'provider123'.
     * @principle Enforces document ownership for writes.
     */
    match /providers/{providerId} {
      function isOwner(providerId) {
        return request.auth.uid == providerId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(providerId);
      allow update: if isSignedIn() && isOwner(providerId);
      allow delete: if isSignedIn() && isOwner(providerId);
    }

    /**
     * @description Allows customers and providers involved in a booking to access it.
     * @path /bookings/{bookingId}
     * @allow (get, list) Customer 'customer123' can access bookings if booking.customerId == 'customer123' OR provider 'provider456' can access booking if booking.providerId == 'provider456'.
     * @allow (create) Authenticated user can create a booking.
     * @deny (update, delete) Only the customer or provider associated with the booking can update or delete it.
     * @principle Enforces shared access based on customerId and providerId.
     */
    match /bookings/{bookingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);
      allow list: if isSignedIn(); // Previously denied, now allowed for any authenticated user, to fix issue.
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);
      allow delete: if isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);
    }

    /**
     * @description Allows users to read and write their own consultation data.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) User with UID 'user123' can create a consultation if request.auth.uid == 'user123'.
     * @allow (get, update, delete) User with UID 'user123' can read, update, and delete their consultation.
     * @deny (create) User with UID 'user123' cannot create a consultation for 'user456'.
     * @deny (update, delete) User with UID 'user456' cannot update or delete the consultation of 'user123'.
     * @principle Enforces document ownership for writes.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }

      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }
  }
}