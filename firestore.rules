/**
 * @fileOverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a user-ownership model for user profiles and consultations.
 * Bookings are accessible to all authenticated users. Provider profiles are only writable by the provider themselves.
 *
 * Data Structure:
 * - /users/{userId}: Stores user profile information, accessible only by the user.
 * - /providers/{providerId}: Stores provider profile information, writable only by the provider.
 * - /bookings/{bookingId}: Stores booking information, readable by all authenticated users.
 * - /users/{userId}/consultations/{consultationId}: Stores consultation history, accessible only by the user.
 *
 * Key Security Decisions:
 * - Users can only access their own profiles and consultation data.
 * - Provider profiles can only be modified by the corresponding provider.
 * - All authenticated users can read bookings.
 * - Listing of user profiles and provider profiles is denied to prevent data scraping.
 *
 * Denormalization for Authorization:
 * No denormalization is necessary in this ruleset. Authorization decisions are based on path parameters
 * and the `request.auth.uid`.
 *
 * Structural Segregation:
 * Private user data (consultations) is stored in a user subcollection, separate from public user profile data.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages user profiles. Users can only read and write their own profile.
     * @path /users/{userId}
     * @allow (create) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create their own profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (get) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can read their own profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (update) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can update their own profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (delete) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can delete their own profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (create) User 'evilUser' cannot create a profile for 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (get) User 'evilUser' cannot read the profile of 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (update) User 'evilUser' cannot update the profile of 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (delete) User 'evilUser' cannot delete the profile of 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing all user profiles

      allow create: if isSignedIn() && isSelfCreate(userId);
      allow update: if isSignedIn() && isExistingOwner(userId);
      allow delete: if isSignedIn() && isExistingOwner(userId);
    }

    /**
     * @description Manages provider profiles. Only the provider can write their profile.
     * @path /providers/{providerId}
     * @allow (create) Provider 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create their own profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (get) Provider 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can read their own profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (update) Provider 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can update their own profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @allow (delete) Provider 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can delete their own profile at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (create) User 'evilUser' cannot create a profile for 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (get) User 'evilUser' cannot read the profile of 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (update) User 'evilUser' cannot update the profile of 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @deny (delete) User 'evilUser' cannot delete the profile of 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /providers/cdar5A4mUuYAKjaHakYYiFwDjtx1.
     * @principle Enforces document ownership for writes.
     */
    match /providers/{providerId} {
      allow get: if true; // Public read for provider profiles
      allow list: if false; // Prevent listing all provider profiles

      allow create: if isSignedIn() && isSelfCreate(providerId);
      allow update: if isSignedIn() && isExistingOwner(providerId);
      allow delete: if isSignedIn() && isExistingOwner(providerId);
    }

    /**
     * @description Manages bookings. Authenticated users can read bookings.
     * @path /bookings/{bookingId}
     * @allow (get) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can read any booking.
     * @allow (list) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can list bookings.
     * @deny (create) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' cannot create bookings without specific authorization logic (TODO).
     * @deny (update) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' cannot update bookings without specific authorization logic (TODO).
     * @deny (delete) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' cannot delete bookings without specific authorization logic (TODO).
     * @principle Authenticated users can read all bookings.
     */
    match /bookings/{bookingId} {
      allow get: if isSignedIn();
      allow list: if isSignedIn();

      allow create: if false; // TODO: Add booking creation logic
      allow update: if false; // TODO: Add booking update logic
      allow delete: if false; // TODO: Add booking deletion logic
    }

    /**
     * @description Manages user consultations. Users can only read and write their own consultations.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create a consultation under their profile at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1/consultations/someConsultationId.
     * @allow (get) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can read their own consultation at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1/consultations/someConsultationId.
     * @allow (update) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can update their own consultation at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1/consultations/someConsultationId.
     * @allow (delete) User 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can delete their own consultation at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1/consultations/someConsultationId.
     * @deny (create) User 'evilUser' cannot create a consultation for 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1/consultations/someConsultationId.
     * @deny (get) User 'evilUser' cannot read the consultation of 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1/consultations/someConsultationId.
     * @deny (update) User 'evilUser' cannot update the consultation of 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1/consultations/someConsultationId.
     * @deny (delete) User 'evilUser' cannot delete the consultation of 'cdar5A4mUuYAKjaHakYYiFwDjtx1' at /users/cdar5A4mUuYAKjaHakYYiFwDjtx1/consultations/someConsultationId.
     * @principle Enforces document ownership for all operations within a user's data tree.
     */
    match /users/{userId}/consultations/{consultationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);

      allow create: if isSignedIn() && isOwner(userId) && isSelfCreate(userId);
      allow update: if isSignedIn() && isOwner(userId) && isExistingOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId) && isExistingOwner(userId);
    }
  }

  // Helper functions
  function isSignedIn() {
    return request.auth != null;
  }

  function isOwner(userId) {
    return request.auth.uid == userId;
  }

    function isSelfCreate(userId) {
      return request.auth.uid == userId;
    }

  function isExistingOwner(userId) {
    return isOwner(userId) && resource != null;
  }
}