rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces user-ownership for user profiles.
     * @path /users/{userId}
     * @allow (get, list) User with ID 'user123' can read their own profile.
     * @allow (create, update, delete) User with ID 'user123' can create, update, and delete their own profile.
     * @deny (get, list) User with ID 'user456' cannot read user 'user123's profile.
     * @deny (create, update, delete) User with ID 'user456' cannot create, update, or delete user 'user123's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner(userId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(userId);
      allow update: if isSignedIn() && isOwner(userId);
      allow delete: if isSignedIn() && isOwner(userId);
    }

    /**
     * @description Enforces user-ownership for provider profiles.
     * @path /providers/{providerId}
     * @allow (get, list) Provider with ID 'provider123' can read their own profile.
     * @allow (create, update, delete) Provider with ID 'provider123' can create, update, and delete their own profile.
     * @deny (get, list) User with ID 'user456' cannot read provider 'provider123's profile.
     * @deny (create, update, delete) User with ID 'user456' cannot create, update, or delete provider 'provider123's profile.
     * @principle Enforces document ownership for all operations.
     */
    match /providers/{providerId} {
      function isOwner(providerId) {
        return request.auth.uid == providerId;
      }
      function isSignedIn() {
        return request.auth != null;
      }
      allow get: if isSignedIn() && isOwner(providerId);
      allow list: if false;
      allow create: if isSignedIn() && isOwner(providerId);
      allow update: if isSignedIn() && isOwner(providerId);
      allow delete: if isSignedIn() && isOwner(providerId);
    }

    /**
     * @description Allows customers and providers involved in a booking to access the booking data.
     * @path /bookings/{bookingId}
     * @allow (get) Customer with ID 'customer123' can read booking 'booking001' if they are the customer.
     * @allow (get) Provider with ID 'provider456' can read booking 'booking001' if they are the provider.
     * @allow (create) Any signed-in user can create a booking.
     * @allow (update) Customer with ID 'customer123' can update booking 'booking001' if they are the customer.
     * @allow (update) Provider with ID 'provider456' can update booking 'booking001' if they are the provider.
     * @allow (delete) Customer with ID 'customer123' can delete booking 'booking001' if they are the customer.
     * @allow (delete) Provider with ID 'provider456' can delete booking 'booking001' if they are the provider.
     * @deny (get) User with ID 'user789' cannot read booking 'booking001' if they are not involved.
     * @deny (update) User with ID 'user789' cannot update booking 'booking001' if they are not involved.
     * @deny (delete) User with ID 'user789' cannot delete booking 'booking001' if they are not involved.
     * @principle Enforces shared access based on customerId and providerId.
     */
    match /bookings/{bookingId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isCustomer() {
          return request.auth.uid == resource.data.customerId;
      }
      function isProvider() {
          return request.auth.uid == resource.data.providerId;
      }

      allow get: if isSignedIn() && (isCustomer() || isProvider());
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (isCustomer() || isProvider());
      allow delete: if isSignedIn() && (isCustomer() || isProvider());
    }

    /**
     * @description Enforces user-ownership for consultations within a user's profile.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (get, list) User with ID 'user123' can read their own consultations.
     * @allow (create, update, delete) User with ID 'user123' can create, update, and delete their own consultations.
     * @deny (get, list) User with ID 'user456' cannot read user 'user123's consultations.
     * @deny (create, update, delete) User with ID 'user456' cannot create, update, or delete user 'user123's consultations.
     * @principle Enforces document ownership for all operations.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isOwner() {
        return request.auth.uid == userId;
      }
      function isSignedIn() {
        return request.auth != null;
      }

      allow get: if isSignedIn() && isOwner();
      allow list: if false;
      allow create: if isSignedIn() && isOwner();
      allow update: if isSignedIn() && isOwner();
      allow delete: if isSignedIn() && isOwner();
    }
  }
}