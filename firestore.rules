/**
 * @file Firestore Security Rules
 * @description This ruleset enforces basic authentication for all data access, requiring users to be logged in.
 *
 * Core Philosophy:
 * The rules prioritize simplicity for the prototyping phase. All write operations require a logged-in user. Schema validation is minimal.
 *
 * Data Structure:
 * - /users/{userId}: User profile data, accessible only by the user themselves.
 * - /providers/{providerId}: Provider profile data, accessible only by the provider themselves.
 * - /bookings/{bookingId}: Booking data, accessible only by authenticated users.
 * - /users/{userId}/consultations/{consultationId}: Consultation data, accessible only by the user themselves.
 *
 * Key Security Decisions:
 * - No public listing is allowed for any collections containing user-specific data.
 * - All write operations require a logged-in user.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Allows authenticated users to read and write their own profile data.
     * @path /users/{userId}
     * @allow (get, list) User with UID 'user123' can read their own profile data.
     * @allow (create, update, delete) User with UID 'user123' can create, update, and delete their own profile data.
     * @deny (get, list) User with UID 'user456' cannot read profile data for user 'user123'.
     * @deny (create, update, delete) User with UID 'user456' cannot create, update, or delete profile data for user 'user123'.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated providers to read and write their own profile data.
     * @path /providers/{providerId}
     * @allow (get, list) Provider with UID 'provider123' can read their own profile data.
     * @allow (create, update, delete) Provider with UID 'provider123' can create, update, and delete their own profile data.
     * @deny (get, list) User with UID 'user456' cannot read provider data for provider 'provider123'.
     * @deny (create, update, delete) User with UID 'user456' cannot create, update, or delete provider data for provider 'provider123'.
     * @principle Enforces document ownership for writes and reads.
     */
    match /providers/{providerId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to read and write booking data.
     * @path /bookings/{bookingId}
     * @allow (get, list) Authenticated user can read booking data.
     * @allow (create, update, delete) Authenticated user can create, update, and delete booking data.
     * @deny (get, list) Unauthenticated user cannot read booking data.
     * @deny (create, update, delete) Unauthenticated user cannot create, update, or delete booking data.
     * @principle Allows any authenticated user to read and write booking data.
     */
    match /bookings/{bookingId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    /**
     * @description Allows authenticated users to read and write their own consultation data.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (get, list) User with UID 'user123' can read their own consultation data.
     * @allow (create, update, delete) User with UID 'user123' can create, update, and delete their own consultation data.
     * @deny (get, list) User with UID 'user456' cannot read consultation data for user 'user123'.
     * @deny (create, update, delete) User with UID 'user456' cannot create, update, or delete consultation data for user 'user123'.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId}/consultations/{consultationId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    function isSignedIn() {
      return request.auth != null;
    }
  }
}