/**
 * @fileoverview Firestore Security Rules for Prototyping.
 *
 * Core Philosophy:
 * This ruleset prioritizes secure authorization while remaining flexible on data shapes to enable rapid prototyping. It enforces strong user ownership and role-based access where appropriate, but it does NOT validate the specific data types or optional fields of the data being written.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only by the owning user.
 * - /providers/{providerId}: Provider profiles, accessible only by the provider themselves.
 * - /bookings/{bookingId}: Bookings accessible to participating customer and provider.
 * - /users/{userId}/consultations/{consultationId}: AI consultations, accessible only by the owning user.
 * - /bookings/{bookingId}/messages: Messages for a booking.
 *
 * Key Security Decisions:
 * - Strict user-ownership model for user profiles and consultations.
 * - Provider-ownership model for provider profiles.
 * - Access control based on participation in bookings.
 * - No listing of user documents or provider documents.
 *
 * Denormalization for Authorization:
 *  - No external data is required to authorize any request. All documents contain necessary fields for validating access.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Secure user profiles. Only the user can read/write their own profile.
     * @path /users/{userId}
     * @allow (create, update, get, delete) if the user is signed in and the userId matches the authenticated user's UID.
     * @deny (create, update, get, delete) if the user is not signed in or the userId does not match the authenticated user's UID.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
      function isExistingOwner(userId) {
          return isSignedIn() && request.auth.uid == userId && resource.data.userId == userId;
      }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    /**
     * @description Secure provider profiles. Only the provider can read/write their own profile.
     * @path /providers/{providerId}
     * @allow (create, update, get, delete) if the provider is signed in and the providerId matches the authenticated user's UID.
     * @deny (create, update, get, delete) if the user is not signed in or the providerId does not match the authenticated user's UID.
     * @principle Enforces document ownership for writes and reads.
     */
    match /providers/{providerId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(providerId) {
        return isSignedIn() && request.auth.uid == providerId;
      }
      function isExistingOwner(providerId) {
        return isSignedIn() && request.auth.uid == providerId && resource.data.providerId == providerId;
      }
      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isOwner(providerId);
      allow update: if isOwner(providerId);
      allow delete: if isOwner(providerId);
    }

    /**
     * @description Secure bookings. Customers and Providers have access to bookings.
     * @path /bookings/{bookingId}
     */
    match /bookings/{bookingId} {
      function isSignedIn() {
        return request.auth != null;
      }

      function isCustomerOrProvider(bookingId) {
            return isSignedIn() && (resource.data.customerId == request.auth.uid || resource.data.providerId == request.auth.uid);
      }
      allow get: if isCustomerOrProvider(bookingId);
      allow list: if false;
      allow create: if isSignedIn();
      allow update: if isCustomerOrProvider(bookingId);
      allow delete: if false;
    }

     /**
      * @description Secure booking messages. Customers and Providers have access to the messages.
      * @path /bookings/{bookingId}/messages
      */
     match /bookings/{bookingId}/messages/{messageId} {
          function isSignedIn() {
            return request.auth != null;
          }

          function isCustomerOrProvider(bookingId) {
                return isSignedIn() && (get(/databases/$(database)/documents/bookings/$(bookingId)).data.customerId == request.auth.uid || get(/databases/$(database)/documents/bookings/$(bookingId)).data.providerId == request.auth.uid);
          }
          allow get: if isCustomerOrProvider(bookingId);
          allow list: if false;
          allow create: if isCustomerOrProvider(bookingId);
          allow update: if false;
          allow delete: if false;
        }
   

    /**
     * @description Secure AI consultations. Only the user can read/write their own consultations.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create, update, get, delete) if the user is signed in and the userId matches the authenticated user's UID.
     * @deny (create, update, get, delete) if the user is not signed in or the userId does not match the authenticated user's UID.
     * @principle Enforces document ownership for writes and reads.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isSignedIn() {
        return request.auth != null;
      }
      function isOwner(userId) {
        return isSignedIn() && request.auth.uid == userId;
      }
        function isExistingOwner(userId) {
            return isSignedIn() && request.auth.uid == userId && resource.data.userId == userId;
        }
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }
  }
}