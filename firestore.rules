/**
 * @fileoverview Firestore Security Rules for the telehealth application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for user profiles and AI consultations.
 * Only authenticated users can access their own data.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profile information.
 * - /providers/{providerId}: Stores verifiable provider information.
 * - /bookings/{bookingId}: Stores booking requests and states.
 * - /users/{userId}/consultations/{consultationId}: Stores AI consultation logs for each user.
 *
 * Key Security Decisions:
 * - Users can only read and write their own profile data under /users/{userId}.
 * - Providers can only manage their own data under /providers/{providerId}.
 * - Listing of users and providers is disallowed for privacy.
 * - AI consultation logs are stored under a user's subcollection and are only accessible by that user.
 *
 * Denormalization for Authorization:
 * - The `Consultation` entity requires `userId` to match the path for easy authorization in rules.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Enforces authentication for all requests.
     */
    function isSignedIn() {
      return request.auth != null;
    }

    /**
     * @description Checks if the current user is the owner of the resource.
     */
    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    /**
     * @description Checks if the current user is the owner of the resource and the resource exists.
     */
    function isExistingOwner(userId) {
      return isOwner(userId) && exists(resource.data);
    }

    /**
     * @description Allows authenticated users to read and write their own user profiles.
     * @path /users/{userId}
     * @allow (get, create, update, delete) User with UID 'user123' can read/write document 'user123'.
     * @deny (get, create, update, delete) User with UID 'user456' cannot read/write document 'user123'.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Prevent listing all users

      allow create: if isSignedIn() && request.auth.uid == userId;
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Allows providers to manage their own provider profiles.
     * @path /providers/{providerId}
     * @allow (get, create, update, delete) Provider with UID 'provider123' can read/write document 'provider123'.
     * @deny (get, create, update, delete) User with UID 'user456' cannot read/write document 'provider123'.
     * @principle Enforces document ownership for provider profiles.
     */
    match /providers/{providerId} {
      allow get: if isOwner(providerId);
      allow list: if false; // Prevent listing all providers

      allow create: if isSignedIn() && request.auth.uid == providerId;
      allow update: if isExistingOwner(providerId);
      allow delete: if isExistingOwner(providerId);
    }

    /**
     * @description Allows customers and providers involved in a booking to access the booking details.
     * @path /bookings/{bookingId}
     */
    match /bookings/{bookingId} {
        // TODO: Implement access control based on customerId and providerId in the booking document.
        allow get, list: if false; // TODO: Implement proper read rules
        allow create: if false; // TODO: Implement proper write rules
        allow update: if false;
        allow delete: if false;
    }

    /**
     * @description Allows users to manage their own consultation logs.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) User with UID 'user123' can create a consultation log under /users/user123/consultations/.
     * @allow (get, list, update, delete) User with UID 'user123' can get, list, update, delete a consultation log under /users/user123/consultations/consultation123.
     * @deny (create, get, list, update, delete) User with UID 'user456' cannot access consultation logs under /users/user123/.
     * @principle Enforces document ownership for consultation logs.
     */
    match /users/{userId}/consultations/{consultationId} {
      allow get: if isOwner(userId);
      allow list: if false; // remove list access

      allow create: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if isExistingOwner(userId);
    }
  }
}