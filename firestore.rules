/**
 * @fileoverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset enforces a strict user-ownership model for private data, augmented
 * with public read access where appropriate. It prioritizes secure access control
 * over complete data validation for rapid prototyping.
 *
 * Data Structure:
 * - /users/{userId}: User profiles, accessible only to the owning user.
 * - /providers/{providerId}: Provider profiles, accessible only to the provider themselves.
 * - /bookings/{bookingId}: Booking data, accessible to involved customers and providers.
 * - /users/{userId}/consultations/{consultationId}: AI consultation logs, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed.
 * - Data validation is minimized in favor of prioritizing authorization.
 * - The rules explicitly deny any potentially open write rules.
 *
 * Denormalization for Authorization:
 *  - The userId is denormalized to consultations to make it easier to enforce that a consultation belongs to a user.
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Protects user profiles.
     * @path /users/{userId}
     * @allow (create) User 'ocRept6zldhhNjRWZ41jY5kV1ME2' can create their profile.
     * @deny (create) User 'attackerId' cannot create a profile for 'ocRept6zldhhNjRWZ41jY5kV1ME2'.
     * @allow (get) User 'ocRept6zldhhNjRWZ41jY5kV1ME2' can read their profile.
     * @deny (list) Listing all users is forbidden.
     * @allow (update) User 'ocRept6zldhhNjRWZ41jY5kV1ME2' can update their profile.
     * @deny (delete) User 'ocRept6zldhhNjRWZ41jY5kV1ME2' cannot delete their profile through the API.
     * @principle Enforces document ownership for user profiles.
     */
    match /users/{userId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow create: if isOwner(userId);
      allow get: if isOwner(userId);
      allow list: if false;
      allow update: if isExistingOwner(userId);
      allow delete: if false;
    }

    /**
     * @description Protects provider profiles.
     * @path /providers/{providerId}
     * @allow (create) Provider 'provider123' can create their profile.
     * @deny (create) User 'attackerId' cannot create a profile for 'provider123'.
     * @allow (get) Provider 'provider123' can read their profile.
     * @deny (list) Listing all providers is forbidden.
     * @allow (update) Provider 'provider123' can update their profile.
     * @deny (delete) Provider 'provider123' cannot delete their profile through the API.
     * @principle Enforces document ownership for provider profiles.
     */
    match /providers/{providerId} {
      function isOwner(providerId) {
        return request.auth != null && request.auth.uid == providerId;
      }

      function isExistingOwner(providerId) {
          return isOwner(providerId) && resource != null;
      }

      allow create: if isOwner(providerId);
      allow get: if isOwner(providerId);
      allow list: if false;
      allow update: if isExistingOwner(providerId);
      allow delete: if false;
    }

    /**
     * @description Protects booking data.
     * @path /bookings/{bookingId}
     * @allow (create) Authenticated users can create bookings.
     * @deny (create) Unauthenticated users cannot create bookings.
     * @allow (get) Authenticated users can read bookings.
     * @deny (list) Listing all bookings is forbidden.
     * @allow (update) Authenticated users can update bookings.
     * @deny (delete) Authenticated users cannot delete bookings.
     */
    match /bookings/{bookingId} {
       function isSignedIn() {
            return request.auth != null;
        }
      allow create: if isSignedIn();
      allow get: if isSignedIn();
      allow list: if false;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    /**
     * @description Protects consultation logs under a specific user.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create) User 'ocRept6zldhhNjRWZ41jY5kV1ME2' can create a consultation log under their ID.
     * @deny (create) User 'attackerId' cannot create a consultation log under user 'ocRept6zldhhNjRWZ41jY5kV1ME2's ID.
     * @allow (get) User 'ocRept6zldhhNjRWZ41jY5kV1ME2' can read their consultation log.
     * @allow (list) User 'ocRept6zldhhNjRWZ41jY5kV1ME2' can list their consultation logs.
     * @allow (update) User 'ocRept6zldhhNjRWZ41jY5kV1ME2' can update their consultation log.
     * @deny (delete) User 'ocRept6zldhhNjRWZ41jY5kV1ME2' cannot delete their consultation log.
     * @principle Enforces document ownership for consultation logs within a user's data tree.
     */
    match /users/{userId}/consultations/{consultationId} {
      function isOwner(userId) {
        return request.auth != null && request.auth.uid == userId;
      }

      function isExistingOwner(userId) {
          return isOwner(userId) && resource != null;
      }

      allow create: if isOwner(userId) && request.resource.data.userId == userId;
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow update: if isExistingOwner(userId);
      allow delete: if false;
    }
  }
}