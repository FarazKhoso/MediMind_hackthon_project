/**
 * @fileOverview Firestore Security Rules for the application.
 *
 * Core Philosophy:
 * This ruleset prioritizes strong authorization based on user identity and explicit ownership.
 * It enforces a user-centric security model where users primarily have access to their own data.
 * Data validation is relaxed to facilitate rapid prototyping and schema evolution.
 *
 * Data Structure:
 * - /users/{userId}: Stores public user profiles, accessible only to the owning user.
 * - /providers/{providerId}: Stores private provider profiles, accessible only to the provider and admins.
 * - /bookings/{bookingId}: Stores booking information, accessible to the involved customer and provider.
 * - /users/{userId}/consultations/{consultationId}: Stores AI consultation data, accessible only to the owning user.
 *
 * Key Security Decisions:
 * - User listing is generally disallowed for privacy.
 * - Write operations are strictly controlled based on ownership or explicit role-based authorization.
 * - Data validation is minimal, focusing on relational integrity rather than comprehensive schema enforcement.
 *
 * Denormalization for Authorization:
 * The rules rely on userId fields within documents to enforce ownership.  For bookings, both `customerId` and `providerId` are used for authorization.
 *
 * Structural Segregation:
 * Provider profiles are stored in a separate top-level collection (/providers) to clearly distinguish them from general user profiles (/users).
 */
rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    /**
     * @description Manages access to user profile documents.
     * @path /users/{userId}
     * @allow (create) User with UID 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create their own profile.
     * @allow (get, update, delete) User with UID 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can read, update, and delete their own profile.
     * @deny (create) User with UID 'attackerId' cannot create a profile with userId 'cdar5A4mUuYAKjaHakYYiFwDjtx1'.
     * @deny (get, update, delete) User with UID 'attackerId' cannot read, update, and delete the profile with userId 'cdar5A4mUuYAKjaHakYYiFwDjtx1'.
     * @principle Enforces document ownership for user profiles, allowing users to manage their own data.
     */
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false;
      allow create: if isOwner(userId) && request.resource.data.email is string && request.resource.data.name is string && request.resource.data.role is string;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(userId);
    }

    /**
     * @description Manages access to provider profile documents.
     * @path /providers/{providerId}
     * @allow (create, get, update, delete) Provider with UID 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can manage their own profile.
     * @deny (create, get, update, delete) User with UID 'attackerId' cannot manage the profile with providerId 'cdar5A4mUuYAKjaHakYYiFwDjtx1'.
     * @principle Enforces document ownership for provider profiles, allowing providers to manage their own data.
     */
    match /providers/{providerId} {
      allow get: if isOwner(providerId);
      allow list: if false;
      allow create: if isOwner(providerId) && request.resource.data.serviceType is string && request.resource.data.licenseUrl is string && request.resource.data.isVerified is bool && request.resource.data.availabilityStatus is string;
      allow update: if isExistingOwner(providerId) && request.resource.data.id == resource.data.id;
      allow delete: if isExistingOwner(providerId);
    }

    /**
     * @description Manages access to booking documents.
     * @path /bookings/{bookingId}
     * @allow (get) User with UID 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can read booking where they are either customer or provider.
     * @allow (list) User with UID 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can list bookings.
     * @allow (create) User with UID 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can create bookings where they are the customer.
     * @allow (update, delete) Users involved (customer or provider) can modify.
     * @deny (create, get, update, delete) Unauthorized user cannot create, read, update or delete the booking with bookingId 'booking123'.
     * @principle Restricts access to bookings based on user involvement (customer or provider).
     */
    match /bookings/{bookingId} {
      allow get: if isCustomerOrProvider(resource.data.customerId, resource.data.providerId);
      allow list: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.customerId == request.auth.uid && request.resource.data.serviceType is string && request.resource.data.location is map && request.resource.data.timing is string && request.resource.data.initialBid is number && request.resource.data.status is string;
      allow update: if isExistingCustomerOrProvider(resource.data.customerId, resource.data.providerId);
      allow delete: if isExistingCustomerOrProvider(resource.data.customerId, resource.data.providerId);
    }

    /**
     * @description Manages access to consultation documents within a user's subcollection.
     * @path /users/{userId}/consultations/{consultationId}
     * @allow (create, get, update, delete) User with UID 'cdar5A4mUuYAKjaHakYYiFwDjtx1' can manage their own consultations.
     * @deny (create, get, update, delete) User with UID 'attackerId' cannot manage the consultation with consultationId 'consult123' under userId 'cdar5A4mUuYAKjaHakYYiFwDjtx1'.
     * @principle Enforces document ownership for consultations, allowing users to manage their own data.
     */
    match /users/{userId}/consultations/{consultationId} {
      allow get: if isOwner(userId);
      allow list: if isOwner(userId);
      allow create: if isOwner(userId) && request.resource.data.id == consultationId && request.resource.data.userId == userId && request.resource.data.query is string && request.resource.data.response is string && request.resource.data.confidenceScore is number && request.resource.data.timestamp is string;
      allow update: if isExistingOwner(userId) && request.resource.data.id == resource.data.id && request.resource.data.userId == resource.data.userId;
      allow delete: if isExistingOwner(userId);
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return request.auth.uid == userId;
    }

    function isExistingOwner(userId) {
      return isOwner(userId) && resource != null;
    }

    function isCustomerOrProvider(customerId, providerId) {
        return request.auth.uid == customerId || request.auth.uid == providerId;
    }

    function isExistingCustomerOrProvider(customerId, providerId) {
        return isCustomerOrProvider(customerId, providerId) && resource != null;
    }
  }
}