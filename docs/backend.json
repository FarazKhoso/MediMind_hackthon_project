
{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "type": "object",
      "description": "Represents a user of the application, who can be either a Customer or a Provider.",
      "properties": {
        "email": {
          "type": "string",
          "description": "Email address of the user.",
          "format": "email"
        },
        "name": {
          "type": "string",
          "description": "Full name of the user."
        },
        "role": {
          "type": "string",
          "description": "The role of the user.",
          "enum": [
            "customer",
            "provider"
          ]
        },
        "phone": {
          "type": "string",
          "description": "Phone number of the user."
        },
        "avatarUrl": {
          "type": "string",
          "description": "URL of the user's profile picture.",
          "format": "uri"
        }
      },
      "required": [
        "email",
        "name",
        "role"
      ]
    },
    "ProviderProfile": {
      "title": "Provider Profile",
      "type": "object",
      "description": "Stores detailed information about a service provider.",
      "properties": {
        "serviceType": {
          "type": "string",
          "description": "The type of service the provider offers.",
          "enum": [
            "doctor",
            "nurse",
            "compounder"
          ]
        },
        "licenseUrl": {
          "type": "string",
          "description": "URL to the provider's professional license.",
          "format": "uri"
        },
        "isVerified": {
          "type": "boolean",
          "description": "Indicates if the provider's license and profile have been verified by an admin."
        },
        "availabilityStatus": {
          "type": "string",
          "description": "The current availability of the provider.",
          "enum": [
            "online",
            "offline"
          ]
        },
        "rating": {
          "type": "number",
          "description": "Average rating of the provider from 1 to 5."
        },
        "reviewCount": {
          "type": "number",
          "description": "Total number of reviews received."
        }
      },
      "required": [
        "serviceType",
        "licenseUrl",
        "isVerified",
        "availabilityStatus"
      ]
    },
    "Booking": {
      "title": "Booking",
      "type": "object",
      "description": "Represents a single service booking.",
      "properties": {
        "customerId": {
          "type": "string",
          "description": "The ID of the customer who made the booking."
        },
        "providerId": {
          "type": "string",
          "description": "The ID of the provider who accepted the booking."
        },
        "serviceType": {
          "type": "string",
          "description": "Type of service requested.",
          "enum": [
            "doctor",
            "nurse",
            "compounder"
          ]
        },
        "location": {
          "type": "object",
          "properties": {
            "latitude": {
              "type": "number"
            },
            "longitude": {
              "type": "number"
            }
          }
        },
        "timing": {
          "type": "string",
          "description": "Requested service time.",
          "format": "date-time"
        },
        "initialBid": {
          "type": "number",
          "description": "The initial price offered by the customer."
        },
        "finalPrice": {
          "type": "number",
          "description": "The final agreed-upon price."
        },
        "status": {
          "type": "string",
          "description": "Current status of the booking.",
          "enum": [
            "requested",
            "negotiating",
            "accepted",
            "in_progress",
            "completed",
            "cancelled"
          ]
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "completedAt": {
          "type": "string",
          "format": "date-time"
        },
        "rating": {
          "type": "number",
          "description": "The rating given by the customer for this specific booking (1-5)."
        }
      },
      "required": [
        "customerId",
        "serviceType",
        "location",
        "timing",
        "initialBid",
        "status"
      ]
    },
    "Consultation": {
      "$schema": "http://json-schema.org/draft-07/schema#",
      "title": "Consultation",
      "type": "object",
      "description": "Represents a single consultation between a user and the AI.",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique identifier for the consultation.",
          "format": "uuid"
        },
        "userId": {
          "type": "string",
          "description": "Reference to User. (Relationship: User 1:N Consultation)"
        },
        "query": {
          "type": "string",
          "description": "The user's query to the AI."
        },
        "response": {
          "type": "string",
          "description": "The AI's response to the user's query."
        },
        "confidenceScore": {
          "type": "number",
          "description": "The AI's confidence score for the response (0-1)."
        },
        "timestamp": {
          "type": "string",
          "description": "Timestamp of the consultation.",
          "format": "date-time"
        },
        "handoffRequested": {
          "type": "boolean",
          "description": "Indicates whether a handoff to a doctor was requested."
        }
      },
      "required": [
        "id",
        "userId",
        "query",
        "response",
        "confidenceScore",
        "timestamp"
      ]
    }
  },
  "auth": {
    "providers": [
      "email",
      "phone"
    ]
  },
  "firestore": {
    "structure": [
      {
        "path": "/users/{userId}",
        "definition": {
          "entityName": "UserProfile",
          "schema": {
            "$ref": "#/backend/entities/UserProfile"
          },
          "description": "Stores public profiles for all users (customers and providers). Access is restricted to the user themselves (path-based ownership).",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user, from Firebase Auth."
            }
          ]
        }
      },
      {
        "path": "/providers/{providerId}",
        "definition": {
          "entityName": "ProviderProfile",
          "schema": {
            "$ref": "#/backend/entities/ProviderProfile"
          },
          "description": "Stores private, verifiable information for providers. Only the provider and admins can write.",
          "params": [
            {
              "name": "providerId",
              "description": "The unique identifier of the provider, same as their userId."
            }
          ]
        }
      },
      {
        "path": "/bookings/{bookingId}",
        "definition": {
          "entityName": "Booking",
          "schema": {
            "$ref": "#/backend/entities/Booking"
          },
          "description": "Stores all booking requests and their states. Accessed by customers and providers involved.",
          "params": [
            {
              "name": "bookingId",
              "description": "The unique identifier for the booking."
            }
          ]
        }
      },
      {
        "path": "/users/{userId}/consultations/{consultationId}",
        "definition": {
          "entityName": "Consultation",
          "schema": {
            "$ref": "#/backend/entities/Consultation"
          },
          "description": "Stores AI consultations for each user.",
          "params": [
            {
              "name": "userId",
              "description": "The unique identifier of the user."
            },
            {
              "name": "consultationId",
              "description": "The unique identifier of the consultation."
            }
          ]
        }
      }
    ]
  }
}
